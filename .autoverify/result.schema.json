{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autoverify Candidate Result",
  "type": "object",
  "required": ["valid", "score", "metric_name", "objective", "status", "metrics", "artifacts"],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "score": {
      "type": ["number", "null"]
    },
    "metric_name": {
      "type": "string"
    },
    "objective": {
      "enum": ["minimize", "maximize"]
    },
    "status": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
